generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Skill {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  category         String
  categoryLabel    String
  difficulty       String
  description      String
  detailedOverview String
  modulesCount     Int      @default(10)
  labsCount        Int      @default(20)
  durationHours    Int      @default(20)
  mentorsCount     Int      @default(10)
  rating           Float    @default(4.9)
  studentsEnrolled Int      @default(100)
  tags             String   // JSON string
  prerequisites    String   // JSON string
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Mentor {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  avatar           String
  role             String
  company          String
  bio              String
  rating           Float    @default(4.9)
  reviewsCount     Int      @default(10)
  studentsMentored Int      @default(50)
  hourlyRate       Int      @default(200)
  isFreeCommunity  Boolean  @default(false)
  availability     String   @default("Available Today")
  timezone         String   @default("IST (India)")
  experienceYears  Int      @default(5)
  skills           String   // JSON string array of slugs
  skillsLabels     String   // JSON string array of display labels
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id                        String          @id @default(cuid())
  email                     String          @unique
  name                      String
  passwordHash              String?
  avatarUrl                 String?
  roles                     String          @default("[\"LEARNER\"]") // JSON string: ["LEARNER"], ["MENTOR"], or both
  activeRole                String          @default("LEARNER")
  emailVerified             Boolean         @default(false)
  learnerOnboardingComplete Boolean         @default(false)
  mentorOnboardingComplete  Boolean         @default(false)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  learnerProfile            LearnerProfile?
  mentorProfile             MentorProfile?
  learnerBookings           Booking[]          @relation("LearnerBookings")
  mentorBookings            Booking[]          @relation("MentorBookings")
  teachingSessions          TeachingSession[]  @relation("MentorTeachingSessions")
  learnerGigs               LearningGig[]      @relation("LearnerGigs")
  gigApplications           GigApplication[]   @relation("MentorGigApplications")
}

model LearnerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interestedSkills String   @default("[]") // JSON string array
  primaryGoal      String   @default("personal")
  experienceLevel  String   @default("Beginner")
  lookingFor       String   @default("mentor")
  timeCommitment   String   @default("3-5 hours/week")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MentorProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  bio               String
  location          String   @default("India")
  teachingSkills    String   @default("[]") // JSON string array
  experienceYears   Int      @default(3)
  hourlyRate        Int      @default(200)
  isFreeCommunity   Boolean  @default(false)
  availability      String   @default("Available Today")
  preferredLanguage String   @default("Hindi / English")
  isPublished       Boolean  @default(true)
  rating            Float    @default(5.0)
  reviewsCount      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Booking {
  id            String   @id @default(cuid())
  learnerId     String
  learner       User     @relation("LearnerBookings", fields: [learnerId], references: [id], onDelete: Cascade)
  mentorId      String
  mentor        User     @relation("MentorBookings", fields: [mentorId], references: [id], onDelete: Cascade)
  skillSlug     String
  topic         String
  scheduledDate DateTime
  timeSlot      String
  status        String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TeachingSession {
  id               String   @id @default(cuid())
  mentorId         String
  mentor           User     @relation("MentorTeachingSessions", fields: [mentorId], references: [id], onDelete: Cascade)
  title            String
  description      String
  learningOutcomes String   @default("[]") // JSON string array of outcomes
  skillSlug        String
  durationMinutes  Int      @default(60)
  price            Int      @default(500)
  level            String   @default("All Levels") // Beginner, Intermediate, Advanced, All Levels
  format           String   @default("1:1 Live Online")
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model LearningGig {
  id              String           @id @default(cuid())
  learnerId       String
  learner         User             @relation("LearnerGigs", fields: [learnerId], references: [id], onDelete: Cascade)
  title           String
  description     String
  skillSlug       String
  level           String           @default("Beginner") // Beginner, Intermediate, Advanced
  durationMinutes Int              @default(60)
  budget          Int              @default(300) // in INR
  preferredTime   String           @default("Flexible / Evening")
  status          String           @default("OPEN") // OPEN, MATCHED, CLOSED
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  applications    GigApplication[]
}

model GigApplication {
  id            String      @id @default(cuid())
  gigId         String
  gig           LearningGig @relation(fields: [gigId], references: [id], onDelete: Cascade)
  mentorId      String
  mentor        User        @relation("MentorGigApplications", fields: [mentorId], references: [id], onDelete: Cascade)
  proposedPrice Int
  message       String
  status        String      @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
