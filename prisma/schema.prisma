generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Skill {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  category         String
  categoryLabel    String
  difficulty       String
  description      String
  detailedOverview String
  modulesCount     Int      @default(10)
  labsCount        Int      @default(20)
  durationHours    Int      @default(20)
  mentorsCount     Int      @default(10)
  rating           Float    @default(4.9)
  studentsEnrolled Int      @default(100)
  tags             String   // Comma-separated or JSON string
  prerequisites    String   // Comma-separated or JSON string
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
